<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- The files under GoldenMaster/ are the golden master: committed output of the
         JsonSubTypes.Text.Json.Aot generator for the domain in TestDomain.cs. They are compiled as
         real sources so coverlet measures them; Sonar reports their coverage (from the
         cobertura reports) but does not run code analysis on them because the generated
         files still carry the // <auto-generated/> and [GeneratedCode] markers.
         Regenerate them (temporarily re-adding the generator with EmitCompilerGeneratedFiles)
         whenever the generator changes, and let the golden-master tests in
         JsonSubTypes.Text.Json.Aot.Generator.Tests verify the committed files still match. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonSubTypes.Text.Json\JsonSubTypes.Text.Json.csproj" />
  </ItemGroup>

</Project>
