<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <!-- native AOT is the most aggressive trimming; for a trimmed-JIT build override PublishAot=false -->
    <PublishTrimmed Condition="'$(PublishAot)'=='false'">true</PublishTrimmed>
    <TrimMode Condition="'$(PublishAot)'=='false'">full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The generic Serialize<T>/Deserialize<T> overloads are used because the generated
         converters are applied through JsonSerializerOptions.Converters. All metadata comes from
         the source-generated context (TypeInfoResolver), so the trimmer's IL2026 is a
         conservative false positive here. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonSubTypes.Text.Json\JsonSubTypes.Text.Json.csproj" />
    <ProjectReference Include="..\JsonSubTypes.Text.Json.Aot\JsonSubTypes.Text.Json.Aot.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
